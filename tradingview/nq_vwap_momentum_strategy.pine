//
// NQ VWAP Momentum Pullback — intraday, session-VWAP, mean-reversion-to-VWAP
// strategy for NQ (Nasdaq-100 E-mini/Micro futures) on a 5-minute chart.
// Distinct from vwap_pullback_strategy.pine in this same folder (that one is
// an ATR-extension/pullback state machine ported from the Python research
// project at the repo root). This script implements a separate, fully
// rule-specified setup:
//
//   LONG bias   : close > VWAP, VWAP rising over the last N bars, and price
//                 up >= momentumPct over the last M bars (1 hour default).
//   SHORT bias  : close < VWAP, VWAP falling over the last N bars, and price
//                 down >= momentumPct over the last M bars.
//   Trigger     : the FIRST red candle after a long bias turns on (pullback
//                 toward VWAP) / the FIRST green candle after a short bias
//                 turns on. Only the first qualifying candle of each bias
//                 episode fires — the state machine re-arms only once the
//                 bias condition goes false and comes back true again.
//   Session     : no new entries 09:30-10:30 America/New_York, no new
//                 entries after 15:30, flatten everything at 16:55.
//   Trade caps  : max 1 open position at a time, max 2 entries/day, and
//                 trading stops for the day after 2 losing trades.
//   Exits       : fixed points, no trailing —
//                   long:  -80 pts stop / +40 pts target
//                   short: -80 pts stop / +50 pts target
//                 converted to ticks via syminfo.mintick so it's correct on
//                 whatever NQ/MNQ contract or tick size the chart is on.
//
// Built for the 5-minute timeframe as specified. The "15 minutes" and
// "1 hour" windows are expressed as bar-count inputs (default 3 and 12,
// i.e. 15m/5m and 60m/5m) so the lookback stays correct if you resample —
// change the inputs, not the code, if you run this on a different
// timeframe.
//
// Not proven profitable. Validate in the Strategy Tester with realistic
// commission/slippage for your contract before considering live use — see
// the top-level README's "Deciding if it's worth going live" checklist,
// which applies here just as much as to the other script in this repo.
//@version=5
strategy(
     "NQ VWAP Momentum Pullback",
     shorttitle           = "NQ-VWAP-MOM",
     overlay              = true,
     initial_capital      = 100000,
     currency             = currency.USD,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     commission_type      = strategy.commission.cash_per_contract,
     commission_value     = 2.25,   // placeholder round-turn $/contract; set your real broker cost in Properties.
     slippage             = 2,      // in ticks; adjust for your instrument in Properties
     pyramiding           = 0,
     calc_on_every_tick   = false)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
vwapSlopeLookback   = input.int(3, "VWAP slope lookback (bars)", minval = 1, group = "Setup", tooltip = "\"Past 15 minutes\" expressed in bars. Default 3 bars = 15 min on a 5-minute chart.")
momentumLookback    = input.int(12, "Momentum lookback (bars)", minval = 1, group = "Setup", tooltip = "\"Past 1 hour\" expressed in bars. Default 12 bars = 60 min on a 5-minute chart.")
momentumPct         = input.float(0.1, "Min 1h price move (%)", minval = 0.0, step = 0.01, group = "Setup")

longStopPts         = input.float(80, "Long stop (points)", minval = 1, group = "Risk Management")
longTargetPts       = input.float(40, "Long target (points)", minval = 1, group = "Risk Management")
shortStopPts        = input.float(80, "Short stop (points)", minval = 1, group = "Risk Management")
shortTargetPts      = input.float(50, "Short target (points)", minval = 1, group = "Risk Management")

maxTradesPerDay     = input.int(2, "Max trades per day", minval = 1, group = "Session & Limits")
maxLossesPerDay     = input.int(2, "Max losses per day", minval = 1, group = "Session & Limits")
blockedStartHour    = input.int(9, "No-trade window start hour (ET)", minval = 0, maxval = 23, group = "Session & Limits")
blockedStartMinute  = input.int(30, "No-trade window start minute (ET)", minval = 0, maxval = 59, group = "Session & Limits")
blockedEndHour      = input.int(10, "No-trade window end hour (ET)", minval = 0, maxval = 23, group = "Session & Limits")
blockedEndMinute    = input.int(30, "No-trade window end minute (ET)", minval = 0, maxval = 59, group = "Session & Limits")
noNewTradesHour     = input.int(15, "No new trades after hour (ET)", minval = 0, maxval = 23, group = "Session & Limits")
noNewTradesMinute   = input.int(30, "No new trades after minute (ET)", minval = 0, maxval = 59, group = "Session & Limits")
flattenHour         = input.int(16, "Flatten all positions at hour (ET)", minval = 0, maxval = 23, group = "Session & Limits")
flattenMinute       = input.int(55, "Flatten all positions at minute (ET)", minval = 0, maxval = 59, group = "Session & Limits")

timezone = "America/New_York"

// ---------------------------------------------------------------------------
// Session VWAP (resets every session)
// ---------------------------------------------------------------------------
newSession = session.isfirstbar

var float cumPV  = na
var float cumVol = na
if newSession
    cumPV  := 0.0
    cumVol := 0.0
cumPV  += hlc3 * volume
cumVol += volume
vwapVal = cumVol > 0 ? cumPV / cumVol : na

vwapRising  = not na(vwapVal[vwapSlopeLookback]) and vwapVal > vwapVal[vwapSlopeLookback]
vwapFalling = not na(vwapVal[vwapSlopeLookback]) and vwapVal < vwapVal[vwapSlopeLookback]

// ---------------------------------------------------------------------------
// 1-hour momentum filter
// ---------------------------------------------------------------------------
priceChangePct = not na(close[momentumLookback]) and close[momentumLookback] != 0 ? (close - close[momentumLookback]) / close[momentumLookback] * 100.0 : na
momentumUp     = not na(priceChangePct) and priceChangePct >= momentumPct
momentumDown   = not na(priceChangePct) and priceChangePct <= -momentumPct

// ---------------------------------------------------------------------------
// Bias conditions
// ---------------------------------------------------------------------------
longBias  = not na(vwapVal) and close > vwapVal and vwapRising and momentumUp
shortBias = not na(vwapVal) and close < vwapVal and vwapFalling and momentumDown

// ---------------------------------------------------------------------------
// Trigger — first red candle toward VWAP after a long bias turns on; first
// green candle toward VWAP after a short bias turns on. Re-arms only after
// the bias condition goes false and true again (so a run of red candles in
// one pullback only fires once).
// ---------------------------------------------------------------------------
var bool longBiasActive  = false
var bool longFired       = false
var bool shortBiasActive = false
var bool shortFired      = false

if longBias
    if not longBiasActive
        longFired := false
    longBiasActive := true
else
    longBiasActive := false
    longFired := false

if shortBias
    if not shortBiasActive
        shortFired := false
    shortBiasActive := true
else
    shortBiasActive := false
    shortFired := false

redCandle   = close < open
greenCandle = close > open

longSignal  = longBias and redCandle and close > vwapVal and not longFired
shortSignal = shortBias and greenCandle and close < vwapVal and not shortFired

if longSignal
    longFired := true
if shortSignal
    shortFired := true

// ---------------------------------------------------------------------------
// Session / time filters (all times America/New_York)
// ---------------------------------------------------------------------------
nyHour   = hour(time, timezone)
nyMinute = minute(time, timezone)
nyMinutesOfDay = nyHour * 60 + nyMinute

blockedStartMin = blockedStartHour * 60 + blockedStartMinute
blockedEndMin   = blockedEndHour * 60 + blockedEndMinute
noNewTradesMin  = noNewTradesHour * 60 + noNewTradesMinute
flattenMin      = flattenHour * 60 + flattenMinute

inBlockedWindow = nyMinutesOfDay >= blockedStartMin and nyMinutesOfDay < blockedEndMin
pastNoNewTrades = nyMinutesOfDay >= noNewTradesMin
pastFlattenTime = nyMinutesOfDay >= flattenMin

// ---------------------------------------------------------------------------
// Daily trade / loss counters (reset each new NY calendar day)
// ---------------------------------------------------------------------------
nyDayId = year(time, timezone) * 10000 + month(time, timezone) * 100 + dayofmonth(time, timezone)

var int tradesToday        = 0
var int lossesToday        = 0
var int lastNyDayId        = na
var int prevClosedTrades   = 0

if na(lastNyDayId) or nyDayId != lastNyDayId
    tradesToday := 0
    lossesToday := 0
    lastNyDayId := nyDayId

if strategy.closedtrades > prevClosedTrades
    lastTradeProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if lastTradeProfit < 0
        lossesToday += 1
    prevClosedTrades := strategy.closedtrades

// ---------------------------------------------------------------------------
// Entries — one position at a time, capped trades/losses per day, no new
// entries in the blocked window or after the daily cutoff.
// ---------------------------------------------------------------------------
canEnter = strategy.position_size == 0 and not inBlockedWindow and not pastNoNewTrades and not pastFlattenTime and tradesToday < maxTradesPerDay and lossesToday < maxLossesPerDay

if longSignal and canEnter
    strategy.entry("Long", strategy.long)
    tradesToday += 1

if shortSignal and canEnter
    strategy.entry("Short", strategy.short)
    tradesToday += 1

// ---------------------------------------------------------------------------
// Exits — fixed points converted to ticks (points / mintick), no trailing.
// ---------------------------------------------------------------------------
strategy.exit("Exit Long", from_entry = "Long", profit = longTargetPts / syminfo.mintick, loss = longStopPts / syminfo.mintick)
strategy.exit("Exit Short", from_entry = "Short", profit = shortTargetPts / syminfo.mintick, loss = shortStopPts / syminfo.mintick)

// End-of-day flatten, independent of the exit orders above.
if pastFlattenTime and strategy.position_size != 0
    strategy.close_all(comment = "eod_flatten")

// ---------------------------------------------------------------------------
// Visuals
// ---------------------------------------------------------------------------
plot(vwapVal, title = "Session VWAP", color = color.new(color.blue, 0), linewidth = 2)
bgcolor(longBiasActive ? color.new(color.green, 92) : shortBiasActive ? color.new(color.red, 92) : na, title = "Bias")
bgcolor(inBlockedWindow ? color.new(color.orange, 85) : na, title = "No-Trade Window")

plotshape(longSignal, title = "Long Trigger", style = shape.triangleup, location = location.belowbar, color = color.new(color.lime, 0), size = size.small)
plotshape(shortSignal, title = "Short Trigger", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.small)

var table infoTable = table.new(position.top_right, 2, 4, border_width = 1)
if barstate.islast
    table.cell(infoTable, 0, 0, "Trades today", bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(infoTable, 1, 0, str.tostring(tradesToday) + " / " + str.tostring(maxTradesPerDay), bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(infoTable, 0, 1, "Losses today", bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(infoTable, 1, 1, str.tostring(lossesToday) + " / " + str.tostring(maxLossesPerDay), bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(infoTable, 0, 2, "Position", bgcolor = color.new(color.blue, 70), text_color = color.white)
    table.cell(infoTable, 1, 2, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", bgcolor = color.new(color.blue, 70), text_color = color.white)
    table.cell(infoTable, 0, 3, "Closed trades", bgcolor = color.new(color.gray, 70), text_color = color.white)
    table.cell(infoTable, 1, 3, str.tostring(strategy.closedtrades), bgcolor = color.new(color.gray, 70), text_color = color.white)

// ---------------------------------------------------------------------------
// Alerts — TradingView Strategy Tester is simulation only; use these with
// Alerts -> webhook to an execution bridge for paper/live use.
// ---------------------------------------------------------------------------
alertcondition(longSignal, title = "NQ VWAP Momentum Long", message = "NQ VWAP MOMENTUM LONG: {{ticker}} @ {{close}}")
alertcondition(shortSignal, title = "NQ VWAP Momentum Short", message = "NQ VWAP MOMENTUM SHORT: {{ticker}} @ {{close}}")
